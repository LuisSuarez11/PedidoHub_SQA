      SELECT "f"."NumFact", "f"."FechaEmision", "f"."IdPedido", "p"."NumMesa", "e"."Nombre", "f"."NIT", (&#xD;
          SELECT COALESCE(SUM(CAST("p0"."Cantidad" AS decimal(10,2)) * "p1"."Precio"), 0.0)&#xD;
          FROM "PedidoPlatos" AS "p0"&#xD;
          INNER JOIN "Platos" AS "p1" ON "p0"."CodPlato" = "p1"."CodPlato"&#xD;
          WHERE "p"."IdPedido" = "p0"."IdPedido")&#xD;
      FROM "Facturas" AS "f"&#xD;
      INNER JOIN "Pedidos" AS "p" ON "f"."IdPedido" = "p"."IdPedido"&#xD;
      INNER JOIN "Empleados" AS "e" ON "p"."IdEmpleado" = "e"."IdEmpleado"&#xD;
      WHERE "f"."FechaEmision" &gt;= @__desde_Value_Date_0 AND "f"."FechaEmision" &lt; @__limite_1&#xD;
      ORDER BY "f"."FechaEmision"&#xD;
