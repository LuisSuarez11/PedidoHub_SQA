      SELECT "p"."IdPedido", "p"."NumMesa", "e"."Nombre" AS "Empleado", "p"."FechaHora", (&#xD;
          SELECT COALESCE(SUM(CAST("p0"."Cantidad" AS decimal(10,2)) * "p1"."Precio"), 0.0)&#xD;
          FROM "PedidoPlatos" AS "p0"&#xD;
          INNER JOIN "Platos" AS "p1" ON "p0"."CodPlato" = "p1"."CodPlato"&#xD;
          WHERE "p"."IdPedido" = "p0"."IdPedido") AS "Total"&#xD;
      FROM "Pedidos" AS "p"&#xD;
      LEFT JOIN "Facturas" AS "f" ON "p"."IdPedido" = "f"."IdPedido"&#xD;
      INNER JOIN "Empleados" AS "e" ON "p"."IdEmpleado" = "e"."IdEmpleado"&#xD;
      WHERE "f"."NumFact" IS NULL AND "p"."Estado" IN ('Abierto', 'Servido')&#xD;
      ORDER BY "p"."FechaHora"&#xD;
