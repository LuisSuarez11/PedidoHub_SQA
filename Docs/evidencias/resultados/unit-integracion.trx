      SELECT "f"."NumFact", "f"."FechaEmision", "f"."IdPedido", "f"."NIT", "p"."IdPedido", "p"."Estado", "p"."FechaHora", "p"."IdEmpleado", "p"."NumMesa", "m"."NumMesa", "m"."Capacidad", "e"."IdEmpleado", "e"."Cargo", "e"."Nombre", "t"."IdPedido", "t"."CodPlato", "t"."Cantidad", "t"."CodPlato0", "t"."Nombre", "t"."Precio"&#xD;
      FROM "Facturas" AS "f"&#xD;
      INNER JOIN "Pedidos" AS "p" ON "f"."IdPedido" = "p"."IdPedido"&#xD;
      INNER JOIN "Mesas" AS "m" ON "p"."NumMesa" = "m"."NumMesa"&#xD;
      INNER JOIN "Empleados" AS "e" ON "p"."IdEmpleado" = "e"."IdEmpleado"&#xD;
      LEFT JOIN (&#xD;
          SELECT "p0"."IdPedido", "p0"."CodPlato", "p0"."Cantidad", "p1"."CodPlato" AS "CodPlato0", "p1"."Nombre", "p1"."Precio"&#xD;
          FROM "PedidoPlatos" AS "p0"&#xD;
          INNER JOIN "Platos" AS "p1" ON "p0"."CodPlato" = "p1"."CodPlato"&#xD;
      ) AS "t" ON "p"."IdPedido" = "t"."IdPedido"&#xD;
      ORDER BY "f"."FechaEmision" DESC, "f"."NumFact", "p"."IdPedido", "m"."NumMesa", "e"."IdEmpleado", "t"."IdPedido", "t"."CodPlato"&#xD;
