      Executed DbCommand (0ms) [Parameters=[@__desde_Value_Date_0='?' (DbType = DateTime), @__limite_1='?' (DbType = DateTime), @__p_2='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT "p"."CodPlato", "p1"."Nombre", "p1"."Precio", COALESCE(SUM("p"."Cantidad"), 0) AS "Unidades"&#xD;
      FROM "PedidoPlatos" AS "p"&#xD;
      INNER JOIN "Pedidos" AS "p0" ON "p"."IdPedido" = "p0"."IdPedido"&#xD;
      LEFT JOIN "Facturas" AS "f" ON "p0"."IdPedido" = "f"."IdPedido"&#xD;
      INNER JOIN "Platos" AS "p1" ON "p"."CodPlato" = "p1"."CodPlato"&#xD;
      WHERE "f"."NumFact" IS NOT NULL AND "f"."FechaEmision" &gt;= @__desde_Value_Date_0 AND "f"."FechaEmision" &lt; @__limite_1&#xD;
      GROUP BY "p"."CodPlato", "p1"."Nombre", "p1"."Precio"&#xD;
      ORDER BY COALESCE(SUM("p"."Cantidad"), 0) DESC, "p1"."Nombre"&#xD;
      LIMIT @__p_2&#xD;
