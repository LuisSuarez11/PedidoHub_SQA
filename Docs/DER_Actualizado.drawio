<mxCell id="c101" value="Notación de Chen. Los atributos con fondo negro son claves; el de línea punteada es derivado (Total_Calc = suma de Cantidad x Precio)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="919" width="1300" height="20" as="geometry"/></mxCell>
<mxCell id="c102" value="(min,máx) = cuántas veces participa una ocurrencia de la entidad en la relación. Ej.: CLIENTE (1,n) posee de 1 a n teléfonos." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="939" width="1300" height="20" as="geometry"/></mxCell>
<mxCell id="c103" value="Razón 1:N, 1:1 o N:M entre las entidades de cada relación. "contiene" es N:M y su atributo Cantidad se guarda en la tabla PedidoPlatos." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="959" width="1300" height="20" as="geometry"/></mxCell>
<mxCell id="c104" value="PEDIDO (0,1) en "genera": un pedido abierto aún no tiene factura. PEDIDO (0,n) en "contiene": al abrirse todavía no tiene platos;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="979" width="1300" height="20" as="geometry"/></mxCell>
<mxCell id="c105" value="para facturar debe tener al menos uno." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="999" width="1300" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
