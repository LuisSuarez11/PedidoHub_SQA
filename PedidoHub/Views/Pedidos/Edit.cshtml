@model PedidoFormViewModel
@{
    ViewData["Title"] = "Editar pedido";
}

<h1>Editar pedido N° @Model.IdPedido</h1>

<form asp-action="Edit" asp-route-id="@Model.IdPedido" class="form-card form-wide">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdPedido" />
    <partial name="_Form" model="Model" />
    <div class="form-actions">
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.IdPedido">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
