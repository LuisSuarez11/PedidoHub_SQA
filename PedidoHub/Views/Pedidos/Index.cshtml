@model IEnumerable<Pedido>
@{
    ViewData["Title"] = "Pedidos";
    var estadoFiltro = ViewData["Estado"] as EstadoPedido?;
    var conteos = (Dictionary<EstadoPedido, int>)ViewData["Conteos"]!;
    var desde = ViewData["Desde"] as DateTime?;
    var hasta = ViewData["Hasta"] as DateTime?;
    var desdeTexto = desde?.ToString("yyyy-MM-dd");
    var hastaTexto = hasta?.ToString("yyyy-MM-dd");

    MenuFilaViewModel MenuDe(int id) => new(new[]
    {
        new MenuFilaItem("Editar", Url.Action("Edit", new { id })!),
        new MenuFilaItem("Eliminar", Url.Action("Delete", new { id })!, true)
    });
}

<div class="title-row">
    <div>
        <h1>Pedidos</h1>
        <p class="title-sub">Cada pedido pertenece a una mesa, lo atiende un empleado y termina en una factura.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nuevo pedido</a>
</div>

<nav class="tabs" aria-label="Estado del pedido">
    <a class="tab @(estadoFiltro is null ? "active" : "")" asp-action="Index" asp-route-desde="@desdeTexto" asp-route-hasta="@hastaTexto">Todos <span class="tab-n">@conteos.Values.Sum()</span></a>
    @foreach (var estado in Enum.GetValues<EstadoPedido>())
    {
        <a class="tab @(estadoFiltro == estado ? "active" : "")" asp-action="Index" asp-route-estado="@estado" asp-route-desde="@desdeTexto" asp-route-hasta="@hastaTexto">@estado <span class="tab-n">@conteos.GetValueOrDefault(estado)</span></a>
    }
</nav>

<div class="toolbar">
    <input type="search" class="form-control toolbar-search" placeholder="Buscar en la lista" aria-label="Buscar en la lista"
           data-filtro="#tabla-pedidos" data-cuenta="#cuenta-pedidos" data-vacio="#vacio-pedidos" data-singular="pedido" data-plural="pedidos" />
    <form method="get" class="toolbar-dates">
        @if (estadoFiltro is not null)
        {
            <input type="hidden" name="estado" value="@estadoFiltro" />
        }
        <input type="date" name="desde" class="form-control" value="@desdeTexto" aria-label="Desde" />
        <input type="date" name="hasta" class="form-control" value="@hastaTexto" aria-label="Hasta" />
        <button type="submit" class="btn btn-secondary">Aplicar</button>
        @if (desde is not null || hasta is not null)
        {
            <a class="btn btn-link" asp-action="Index" asp-route-estado="@estadoFiltro">Quitar fechas</a>
        }
    </form>
    <span class="toolbar-count" id="cuenta-pedidos">@Model.Count() @(Model.Count() == 1 ? "pedido" : "pedidos")</span>
</div>

<div class="table-responsive">
<table class="table align-middle" id="tabla-pedidos">
    <thead>
        <tr>
            <th>Pedido</th>
            <th>Fecha y hora</th>
            <th>Mesa</th>
            <th>Atiende</th>
            <th>Estado</th>
            <th class="text-end">Total</th>
            <th><span class="visually-hidden">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pedido in Model)
        {
            <tr>
                <td class="mono"><a asp-action="Details" asp-route-id="@pedido.IdPedido">N° @pedido.IdPedido</a></td>
                <td>@pedido.FechaHora.ToString("yyyy-MM-dd HH:mm")</td>
                <td>Mesa @pedido.Mesa.NumMesa</td>
                <td>@pedido.Empleado.Nombre</td>
                <td><span class="estado estado-@pedido.Estado.ToString().ToLower()">@pedido.Estado</span></td>
                <td class="text-end">@pedido.Total.ToString("N2")</td>
                <td>
                    <div class="cell-actions">
                        <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@pedido.IdPedido">Abrir</a>
                        @if (pedido.Factura is null)
                        {
                            <partial name="_MenuFila" model="MenuDe(pedido.IdPedido)" />
                        }
                        else
                        {
                            <span class="btn-icon-spacer" aria-hidden="true"></span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<p class="empty-state" id="vacio-pedidos" @(Model.Any() ? "hidden" : "")>
    No hay pedidos con estos filtros. <a asp-action="Create">Abrir un pedido</a>.
</p>
