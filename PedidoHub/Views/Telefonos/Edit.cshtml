@model TelefonoCliente
@{
    ViewData["Title"] = "Editar teléfono";
}

<h1>Editar teléfono</h1>

<form asp-action="Edit" asp-route-id="@Model.IdTelefono" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdTelefono" />
    <partial name="_Form" model="Model" view-data="ViewData" />
    <div class="form-actions">
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.IdCliente">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
