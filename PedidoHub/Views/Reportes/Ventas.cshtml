@model ReporteVentasViewModel
@{
    var hoy = DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var inicioMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    ViewData["Title"] = "Ventas por período";
}

<div class="title-row">
    <div>
        <h1>Ventas por período</h1>
        <p class="title-sub">Facturas emitidas en el período, para saber cuánto vendió el restaurante y cuánto atendió cada empleado.</p>
    </div>
</div>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="Desde" class="form-label"></label>
        <input asp-for="Desde" type="date" class="form-control" />
        <span asp-validation-for="Desde" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <label asp-for="Hasta" class="form-label"></label>
        <input asp-for="Hasta" type="date" class="form-control" />
        <span asp-validation-for="Hasta" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <label asp-for="IdEmpleado" class="form-label"></label>
        <select asp-for="IdEmpleado" asp-items="Model.Empleados" class="form-select">
            <option value="">Todos</option>
        </select>
        <span asp-validation-for="IdEmpleado" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Generar reporte</button>
        <a class="btn btn-link" asp-action="Ventas">Limpiar</a>
    </div>
    <div class="col-12 d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted">Período rápido:</span>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Ventas" asp-route-Desde="@hoy" asp-route-Hasta="@hoy" asp-route-IdEmpleado="@Model.IdEmpleado">Hoy</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Ventas" asp-route-Desde="@inicioMes" asp-route-Hasta="@hoy" asp-route-IdEmpleado="@Model.IdEmpleado">Este mes</a>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="note note--error" role="alert">Revisa los filtros marcados y vuelve a generar el reporte.</div>
}
else
{
<ul class="summary">
    <li><strong class="hue">@Model.TotalFacturado.ToString("N2")</strong>total facturado</li>
    <li><strong>@Model.CantidadFacturas</strong>@(Model.CantidadFacturas == 1 ? "factura emitida" : "facturas emitidas")</li>
    <li><strong>@(Model.CantidadFacturas == 0 ? "—" : Model.TicketPromedio.ToString("N2"))</strong>ticket promedio</li>
</ul>

<div class="table-responsive">
<table class="table align-middle">
    <thead>
        <tr>
            <th>Factura</th>
            <th>Fecha de emisión</th>
            <th>Pedido</th>
            <th>Mesa</th>
            <th>Empleado</th>
            <th>NIT</th>
            <th class="text-end">Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fila in Model.Filas)
        {
            <tr>
                <td class="mono"><a asp-controller="Facturas" asp-action="Details" asp-route-id="@fila.NumFact">N° @fila.NumFact</a></td>
                <td>@fila.FechaEmision.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="mono">N° @fila.IdPedido</td>
                <td>Mesa @fila.NumMesa</td>
                <td>@fila.Empleado</td>
                <td class="mono">@fila.Nit</td>
                <td class="text-end">@fila.Total.ToString("N2")</td>
            </tr>
        }
    </tbody>
    @if (Model.Filas.Any())
    {
        <tfoot>
            <tr>
                <th colspan="6" class="text-end">Total facturado</th>
                <th class="text-end">@Model.TotalFacturado.ToString("N2")</th>
            </tr>
        </tfoot>
    }
</table>
</div>

@if (!Model.Filas.Any())
{
    <p class="text-muted">No hay facturas para los filtros indicados.</p>
}
}
