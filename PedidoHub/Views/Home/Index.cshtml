@model CalidadViewModel
@{
    ViewData["Title"] = "Gestión de restaurante con calidad medible";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<section class="pub-wrap hero">
    <div>
        <h1>Tu restaurante bajo control, con <em>calidad medible</em>.</h1>
        <p class="lead">PedidoHub reúne mesas, reservas, pedidos, facturación y reportes en un solo lugar, con accesos por rol, bitácora de cambios y un panel que muestra cómo se asegura la calidad del propio sistema.</p>
        <div class="acciones">
            <a class="btn-lg-ph primario" asp-controller="Cuenta" asp-action="Ingresar">Ingresar al sistema</a>
            <a class="btn-lg-ph secundario" href="#calidad">Ver cómo se asegura la calidad</a>
        </div>
    </div>
    <div class="maqueta" aria-hidden="true">
        <div class="maqueta-barra"><span></span><span></span><span></span></div>
        <div class="maqueta-grid">
            <div class="maqueta-mesa"><b>Mesa 1</b><small>2 personas</small><br /><span class="pildora p-libre">Libre</span></div>
            <div class="maqueta-mesa"><b>Mesa 2</b><small>4 personas</small><br /><span class="pildora p-ocupada">Ocupada</span></div>
            <div class="maqueta-mesa"><b>Mesa 3</b><small>4 personas</small><br /><span class="pildora p-reservada">Reservada</span></div>
            <div class="maqueta-mesa"><b>Mesa 4</b><small>6 personas</small><br /><span class="pildora p-libre">Libre</span></div>
            <div class="maqueta-mesa"><b>Mesa 5</b><small>8 personas</small><br /><span class="pildora p-ocupada">Ocupada</span></div>
            <div class="maqueta-mesa"><b>Mesa 6</b><small>2 personas</small><br /><span class="pildora p-libre">Libre</span></div>
        </div>
        <div class="maqueta-pie"><span>Por cobrar hoy</span><strong>Bs 248.00</strong></div>
    </div>
</section>

<section class="franja" aria-label="Indicadores de calidad">
    <div class="pub-wrap franja-grid">
        <div class="franja-item"><strong>@Model.TotalPruebas</strong><span>pruebas automatizadas</span></div>
        <div class="franja-item"><strong>@Model.TasaExito.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</strong><span>tasa de éxito</span></div>
        <div class="franja-item"><strong>@Model.CoberturaGlobal.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</strong><span>cobertura de líneas</span></div>
        <div class="franja-item"><strong>@Model.DefectosCerrados / @Model.Datos.Defectos.Count</strong><span>defectos corregidos</span></div>
    </div>
</section>

<section class="seccion pub-wrap" id="funciones">
    <h2>Todo el servicio en un solo sistema</h2>
    <p class="sub">Del plano de mesas a la factura, sin planillas ni papeles sueltos.</p>
    <div class="rejilla-3">
        <div class="tarjeta-f"><div class="icono">1</div><h3>Plano de mesas en vivo</h3><p>Cada mesa muestra si está libre, ocupada o reservada y cuánto lleva consumido. Se abre un pedido con un toque.</p></div>
        <div class="tarjeta-f"><div class="icono">2</div><h3>Pedidos y facturación</h3><p>Platos con cantidades, total calculado y facturas con NIT validado. Una mesa nunca tiene dos cuentas abiertas.</p></div>
        <div class="tarjeta-f"><div class="icono">3</div><h3>Reservas sin choques</h3><p>Controla capacidad, fechas y superposición de horarios de dos horas por mesa.</p></div>
        <div class="tarjeta-f"><div class="icono">4</div><h3>Reportes y exportación</h3><p>Ventas por período y platos más vendidos, con exportación a CSV lista para Excel.</p></div>
        <div class="tarjeta-f"><div class="icono">5</div><h3>Roles y bitácora</h3><p>Administrador, mesero y cajero con permisos distintos, y un registro de quién cambió qué y cuándo.</p></div>
        <div class="tarjeta-f"><div class="icono">6</div><h3>Búsqueda instantánea</h3><p>Con Ctrl + K se encuentra cualquier cliente, plato, pedido o factura y se salta a cualquier pantalla.</p></div>
    </div>
</section>

<section class="seccion pub-wrap" id="calidad">
    <div class="fila-calidad">
        <div>
            <h2>La calidad también se mide aquí</h2>
            <p class="sub">PedidoHub se desarrolla con un Test Plan ágil: las pruebas se escriben antes del código, el pipeline las ejecuta en cada cambio y los resultados se publican en un panel.</p>
            <ol class="pipeline p-0">
                <li><strong>Prueba primero (TDD)</strong><span>Cada regla de negocio nace como una prueba en rojo.</span></li>
                <li><strong>Integración continua</strong><span>Compila y ejecuta xUnit, Selenium y Cypress en cada cambio.</span></li>
                <li><strong>Auditoría interna</strong><span>Hallazgos con severidad, corrección y prueba de regresión.</span></li>
                <li><strong>Métricas y mejora continua</strong><span>Cobertura, tasa de éxito y densidad de defectos por sprint.</span></li>
            </ol>
        </div>
        <div>
            @foreach (var suite in Model.Datos.Pruebas)
            {
                <div class="barra-fila">
                    <span class="etq">@suite.Nombre <small class="text-muted">· @suite.Herramienta</small></span>
                    <span class="barra"><i style="width:@(suite.Total == 0 ? 0 : 100 * suite.Pasadas / suite.Total)%"></i></span>
                    <span class="text-end">@suite.Pasadas / @suite.Total</span>
                </div>
            }
        </div>
    </div>
</section>

<section class="seccion pub-wrap" id="roles">
    <h2>Cada persona ve lo que necesita</h2>
    <p class="sub">El acceso depende del rol; lo no autorizado devuelve una pantalla de acceso denegado.</p>
    <table class="tabla-roles">
        <thead><tr><th>Rol</th><th>Puede</th></tr></thead>
        <tbody>
            <tr><td><strong>Administrador</strong></td><td>Todo el sistema, empleados, reportes, panel de calidad y bitácora de auditoría.</td></tr>
            <tr><td><strong>Cajero</strong></td><td>Pedidos, reservas, facturación y reportes de ventas.</td></tr>
            <tr><td><strong>Mesero</strong></td><td>Plano de mesas, pedidos, reservas y clientes.</td></tr>
        </tbody>
    </table>
</section>