@model MenuFilaViewModel

<div class="dropdown">
    <button class="btn-icon" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}'
            aria-expanded="false" aria-label="Más acciones">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <circle cx="3" cy="8" r="1.4" /><circle cx="8" cy="8" r="1.4" /><circle cx="13" cy="8" r="1.4" />
        </svg>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        @foreach (var item in Model.Items)
        {
            <li><a class="dropdown-item @(item.Peligro ? "is-danger" : "")" href="@item.Url">@item.Texto</a></li>
        }
    </ul>
</div>
