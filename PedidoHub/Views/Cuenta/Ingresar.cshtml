@model IngresarViewModel
@{
    ViewData["Title"] = "Ingresar";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<div class="login-pagina">
    <div class="login-caja">
        <h1>Ingresar a PedidoHub</h1>
        <p class="text-muted">Use su usuario y contraseña para continuar.</p>
        <form asp-action="Ingresar" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label"></label>
                <input asp-for="NombreUsuario" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Clave" class="form-label"></label>
                <input asp-for="Clave" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
        <p class="nota">Usuarios de demostración: <code>admin</code>, <code>cajero</code> y <code>mesero</code>. La contraseña inicial está en el README.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}