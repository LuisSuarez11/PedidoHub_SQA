@model IEnumerable<Bitacora>
@{
    ViewData["Title"] = "Bitácora de auditoría";
    var usuario = ViewData["Usuario"] as string;
    var entidad = ViewData["Entidad"] as string;
    var pagina = (int)ViewData["Pagina"]!;
    var totalPaginas = (int)ViewData["TotalPaginas"]!;
    var entidades = (List<string>)ViewData["Entidades"]!;
}

<div class="title-row">
    <div>
        <h1>Bitácora de auditoría</h1>
        <p class="title-sub">Registro de quién creó, modificó o eliminó cada dato (@ViewData["Total"] movimientos).</p>
    </div>
</div>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="usuario">Usuario</label>
        <input id="usuario" name="usuario" value="@usuario" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="entidad">Entidad</label>
        <select id="entidad" name="entidad" class="form-select">
            <option value="">Todas</option>
            @foreach (var e in entidades)
            {
                <option value="@e" selected="@(e == entidad)">@e</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay movimientos registrados.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Registro</th><th>Detalle</th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td class="text-nowrap">@b.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@b.Usuario</td>
                    <td>@b.Accion</td>
                    <td>@b.Entidad</td>
                    <td>@b.Registro</td>
                    <td>@b.Detalle</td>
                </tr>
            }
        </tbody>
    </table>
    <nav aria-label="Paginación" class="d-flex gap-2 align-items-center">
        @if (pagina > 1)
        {
            <a class="btn btn-secondary btn-sm" asp-action="Index" asp-route-usuario="@usuario" asp-route-entidad="@entidad" asp-route-pagina="@(pagina - 1)">Anterior</a>
        }
        <span class="text-muted">Página @pagina de @totalPaginas</span>
        @if (pagina < totalPaginas)
        {
            <a class="btn btn-secondary btn-sm" asp-action="Index" asp-route-usuario="@usuario" asp-route-entidad="@entidad" asp-route-pagina="@(pagina + 1)">Siguiente</a>
        }
    </nav>
}