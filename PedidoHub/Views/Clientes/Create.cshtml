@model ClienteFormViewModel
@{
    ViewData["Title"] = "Nuevo cliente";
}

<h1>Nuevo cliente</h1>

<form asp-action="Create" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autofocus />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" inputmode="tel" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
        <div class="form-text">Todo cliente necesita al menos un teléfono. Podrá agregar más desde su ficha.</div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
